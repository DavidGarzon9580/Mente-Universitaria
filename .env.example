# Copia este archivo como .env y completa tu clave. Nunca subas .env a GitHub.
PORT=3000
NODE_ENV=development

# La aplicación funciona sin esta clave, excepto el generador con IA.
# Crea una clave gratis en https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_MS=30000
